# Copie este arquivo para .env e preencha. O .env nunca vai para o git.
#
# Tudo que começa com VITE_ é embutido no app e fica visível no navegador.
# Por isso aqui só entram valores PÚBLICOS. Chaves secretas (Mercado Pago,
# Asaas, VAPID privada, service role) ficam só nos "secrets" das Edge
# Functions: supabase secrets set NOME=valor

# Supabase → seu projeto → Settings → API (URL e chave "anon public")
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública do app (usada em links)
VITE_APP_URL=http://localhost:5173

# Chave PÚBLICA VAPID (notificação push). A privada vai só nos secrets.
VITE_VAPID_PUBLIC_KEY=
